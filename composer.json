{
    "name": "pieceofcake2/phpstan-cakephp2",
    "description": "An extension to help test CakePHP 2 projects with PHPStan",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "phpstan/phpstan": "^2.0"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^5.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^9.6",
        "pieceofcake2/cakephp": "^2.12"
    },
    "autoload": {
        "psr-4": {
            "PHPStanCakePHP2\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PHPStanCakePHP2\\Test\\": "tests/"
        },
        "classmap": [
            "tests/Feature/apps",
            "tests/Feature/classes",
            "vendor/pieceofcake2/cakephp/src/Cake/Cache",
            "vendor/pieceofcake2/cakephp/src/Cake/Config",
            "vendor/pieceofcake2/cakephp/src/Cake/Console/Shell.php",
            "vendor/pieceofcake2/cakephp/src/Cake/Core",
            "vendor/pieceofcake2/cakephp/src/Cake/Controller",
            "vendor/pieceofcake2/cakephp/src/Cake/Event",
            "vendor/pieceofcake2/cakephp/src/Cake/Model",
            "vendor/pieceofcake2/cakephp/src/Cake/Utility",
            "vendor/pieceofcake2/cakephp/src/Cake/View"
        ]
    },
    "scripts": {
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "phpstan": "phpstan",
        "phpunit": "phpunit",
        "test": [
            "@phpunit",
            "@phpstan",
            "@cs-check"
        ]
    },
    "extra": {
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    }
}
